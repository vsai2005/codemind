generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          Role      @default(USER)
  /// scrypt hash, never plaintext. Nullable so OAuth-only or legacy demo accounts
  /// remain valid. NEVER selected into an API response — see lib/auth/password.ts.
  passwordHash  String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt @default(now())

  tasks         Task[]
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  conversations Conversation[]
  artifacts     Artifact[]

  /// No @@index([email]): `@unique` above already creates one. A second, non-unique
  /// index over the same column only adds write cost on a table that is written on
  /// every sign-up and read on every sign-in.
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  tags        String[]     @default([])
  dueDate     DateTime?
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([dueDate])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String         @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  /// Standing instructions applied to every conversation in this project, injected
  /// through the existing ContextManager rather than a parallel context system.
  instructions String? @db.Text

  /// Durable project knowledge, grouped by section:
  ///   [{ "title": "Technology", "items": ["Next.js", "PostgreSQL"] }]
  /// User-editable and model-neutral — it is not a conversation summary.
  memory Json?

  /// Archived projects stay fully intact and readable; they are only hidden from
  /// the default sidebar listing. Archiving is never a soft delete.
  archivedAt DateTime?

  conversations Conversation[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model Conversation {
  id        String    @id @default(cuid())
  title     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  summary   String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages  Message[]

  @@index([userId])
  @@index([projectId])
  /// Backs the sidebar's "most recent conversations for this user" query.
  @@index([userId, updatedAt])
}

enum MessageRole {
  system
  user
  assistant
  data
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  /// Which model produced this message. Assistant messages only; null for user
  /// messages and for anything written before multi-model support, which must keep
  /// rendering normally.
  ///
  /// Deliberately free-form strings rather than an enum: adding a future provider
  /// should not require a schema migration. Credentials are NEVER stored here.
  provider String?
  model    String?

  /// User-facing implementation plan shown above the reply (see lib/ai/planning.ts).
  /// A column rather than a table: it is small, always read with its message, and has
  /// no independent lifetime. Nullable so unplanned and pre-existing messages stay
  /// valid. Contains a specification, never model reasoning.
  plan Json?

  artifacts Artifact[]

  @@index([conversationId])
  /// Backs ordered message loads and the historical-retrieval scan.
  @@index([conversationId, createdAt])
}

enum ArtifactType {
  zip
  pdf
  file
}

/// Generated deliverables (project archives, documents, single files).
///
/// `payload` holds the normalized internal representation and therefore the full
/// file contents. It is server-only: API responses expose id/type/filename/size
/// but never this column.
model Artifact {
  id        String       @id @default(cuid())
  messageId String
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Denormalised owner. Ownership is already derivable via message -> conversation,
  /// but storing it directly lets a download be authorised with one indexed predicate
  /// instead of a three-table join, and makes "list my artifacts" cheap.
  /// Nullable so the migration can backfill existing rows without downtime.
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ArtifactType
  filename  String
  fileCount Int          @default(0)
  byteSize  Int          @default(0)
  payload   Json
  createdAt DateTime     @default(now())

  @@index([messageId])
  @@index([userId, createdAt])
}

