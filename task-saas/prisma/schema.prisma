generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          Role      @default(USER)
  /// scrypt hash, never plaintext. Nullable so OAuth-only or legacy demo accounts
  /// remain valid. NEVER selected into an API response — see lib/auth/password.ts.
  passwordHash  String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  tasks         Task[]
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  conversations Conversation[]
  artifacts     Artifact[]

  /// No @@index([email]): `@unique` above already creates one. A second, non-unique
  /// index over the same column only adds write cost on a table that is written on
  /// every sign-up and read on every sign-in.
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  tags        String[]     @default([])
  dueDate     DateTime?
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([dueDate])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Standing instructions applied to every conversation in this project, injected
  /// through the existing ContextManager rather than a parallel context system.
  instructions String? @db.Text

  /// Durable project knowledge, grouped by section:
  ///   [{ "title": "Technology", "items": ["Next.js", "PostgreSQL"] }]
  /// User-editable and model-neutral — it is not a conversation summary.
  memory Json?

  /// Archived projects stay fully intact and readable; they are only hidden from
  /// the default sidebar listing. Archiving is never a soft delete.
  archivedAt DateTime?

  /// The indexed repository this workspace asks questions about, if any.
  ///
  /// The link lives here rather than on Conversation for two reasons. The chat route
  /// already loads the project when a conversation belongs to one, so a repo-backed
  /// conversation costs no extra query; and every query against Project in that route
  /// uses an explicit `select`, so adding this column cannot break a request that does
  /// not ask for it. The same column on Conversation would be read by a `findFirst`
  /// with no select — every column, every chat request — and shipping the code before
  /// the migration would 500 the entire chat path rather than only the repo features.
  ///
  /// SetNull rather than Cascade: dropping an index must never delete the user's
  /// workspace, conversations and instructions along with it.
  repositoryId String?
  repository   Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  conversations Conversation[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model Conversation {
  id             String    @id @default(cuid())
  title          String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  summary        String?   @db.Text
  /// Optimistic-concurrency guard for `summary`.
  ///
  /// Summarization is detached from the request that triggers it, so two turns in one
  /// conversation can summarize at once. Both read the same summary, both merge their
  /// own dropped messages into it, and a plain write means the slower one silently
  /// discards the other's memory — invisibly, because the result still looks like a
  /// valid summary.
  ///
  /// The version read alongside the summary is part of the WHERE clause on write, and
  /// bumped by it. A losing write matches no row, updates nothing, and is logged.
  /// Non-null with a default so existing rows start at 0 without a backfill.
  summaryVersion Int       @default(0)
  /// Same contract as Project.archivedAt: presentation-only, hides the conversation
  /// from the default sidebar listing, never touches messages or artifacts. A project
  /// being archived does not cascade here — a conversation keeps its own archive state
  /// independent of its project's, so restoring a project does not silently unarchive
  /// chats the user archived individually.
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages Message[]

  @@index([userId])
  @@index([projectId])
  /// Backs the sidebar's "most recent conversations for this user" query.
  @@index([userId, updatedAt])
}

enum MessageRole {
  system
  user
  assistant
  data
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  /// Which model produced this message. Assistant messages only; null for user
  /// messages and for anything written before multi-model support, which must keep
  /// rendering normally.
  ///
  /// Deliberately free-form strings rather than an enum: adding a future provider
  /// should not require a schema migration. Credentials are NEVER stored here.
  provider String?
  model    String?

  /// User-facing implementation plan shown above the reply (see lib/ai/planning.ts).
  /// A column rather than a table: it is small, always read with its message, and has
  /// no independent lifetime. Nullable so unplanned and pre-existing messages stay
  /// valid. Contains a specification, never model reasoning.
  plan Json?

  /// Tokens the provider reported for this turn. Assistant messages only.
  ///
  /// Nullable because population is PER PROVIDER. A provider reports usage on the
  /// streaming path only when the request set stream_options.include_usage, which
  /// @ai-sdk/openai sends only under `compatibility: "strict"`. NVIDIA is set to
  /// strict and verified populating against the live API; Google and DeepSeek are
  /// still "compatible" and so still write null here.
  ///
  /// Null therefore means "not reported", never "zero".
  ///
  /// Visibility only. No pricing, cost or spend logic reads these.
  promptTokens     Int?
  completionTokens Int?

  /// Idempotency key for the turn this user message opened. User messages only.
  ///
  /// HELD ONLY WHILE THE TURN IS UNRESOLVED. It is set when the message is written,
  /// before generation starts, and cleared in the same transaction that persists the
  /// assistant reply. So the unique index guards exactly the window where a retry
  /// would duplicate, and stops guarding the moment the turn succeeds.
  ///
  /// That is deliberate. Keeping the key forever would block a user legitimately
  /// sending the same text twice ("continue", "yes") in one conversation, which is
  /// normal. Releasing it on completion means a legitimate repeat always finds the
  /// key free, because a completed turn released it.
  ///
  /// The value is a sha256 over the user id plus the request identity, so it is
  /// opaque, fixed-width, and cannot collide across users even if two people supply
  /// the same client-side key. Nullable and unique: Postgres permits many NULLs, so
  /// existing rows and every assistant message stay valid.
  idempotencyKey String? @unique

  artifacts       Artifact[]
  /// Outcome of one artifact ATTEMPT, when this turn was an artifact turn.
  ///
  /// Exists because Artifact.verification cannot measure what it was meant to. A
  /// rejected artifact is never persisted, so the Artifact table holds only successes
  /// and any success rate computed from it is 100% by construction. This row is written
  /// whether the attempt succeeded or failed, which is what makes the rate real.
  ///
  /// Deliberately NOT a copy of the verification report: it records the STAGE that
  /// ended the attempt — generation, truncation, parse, validation, verification,
  /// packaging, persisted — plus counts and codes. Those stages call for opposite
  /// responses, and collapsing them into "failed" would make the measurement useless.
  ///
  /// Null means this turn was not an artifact attempt, or predates this column. It
  /// never means an attempt that succeeded silently.
  artifactAttempt Json?

  @@index([conversationId])
  /// Backs ordered message loads and the historical-retrieval scan.
  @@index([conversationId, createdAt])
}

enum ArtifactType {
  zip
  pdf
  file
}

/// Generated deliverables (project archives, documents, single files).
///
/// `payload` holds the normalized internal representation and therefore the full
/// file contents. It is server-only: API responses expose id/type/filename/size
/// but never this column.
model Artifact {
  id        String       @id @default(cuid())
  messageId String
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Denormalised owner. Ownership is already derivable via message -> conversation,
  /// but storing it directly lets a download be authorised with one indexed predicate
  /// instead of a three-table join, and makes "list my artifacts" cheap.
  /// Nullable so the migration can backfill existing rows without downtime.
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ArtifactType
  filename  String
  fileCount Int          @default(0)
  byteSize  Int          @default(0)
  payload   Json

  /// Static verification report for this artifact — see lib/artifacts/verify.ts.
  ///
  /// NULLABLE, and the null case means something specific: this artifact predates
  /// verification, or was written by a path that did not run it. A row with `null`
  /// here has NOT been checked and found clean; it has not been checked. Defaulting it
  /// to an empty passing report would erase that difference and quietly inflate any
  /// measurement taken over this column.
  ///
  /// Only successful artifacts have rows at all, because an artifact with verification
  /// errors is never persisted. This column therefore measures WARNING rates and which
  /// checks ran — not the pass/fail rate of generation, which would need failures to
  /// be recorded somewhere they currently are not.
  verification Json?

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Repository ingestion
// ---------------------------------------------------------------------------

enum RepositoryStatus {
  pending
  indexing
  ready
  failed
}

/// An indexed snapshot of a PUBLIC GitHub repository at one commit.
///
/// WHY AN INDEX AND NOT A CLONE
/// Render gives this app no persistent disk and 512 MB of memory, and the free tier
/// spins the instance down after ~15 minutes idle. A clone does not survive a cold
/// start, re-cloning on every wake is not viable, and a large repo does not fit in
/// memory even transiently. So nothing is stored but the file LIST; contents are
/// fetched from the GitHub API at query time, for the handful of files a question
/// actually needs.
///
/// WHY KEYED ON A COMMIT SHA
/// The index is a pure function of the commit, so a snapshot is immutable and
/// re-ingestion is idempotent by construction: a newer commit is a NEW row, and the
/// previous one stays readable until the new one reaches `ready`. There is no moment
/// where a half-built index has replaced a good one.
///
/// ⚠️ NOT SCOPED TO A USER, AND THAT IS ONLY SAFE WHILE REPOSITORIES ARE PUBLIC.
/// Two users pointing at the same commit share one index, which is correct precisely
/// because the content is public to begin with — the index reveals nothing its source
/// does not. THE MOMENT PRIVATE REPOSITORIES ARE SUPPORTED THIS BECOMES A
/// CROSS-TENANT LEAK: user A would read user B's private file list, and the fetch
/// path would happily serve contents against a token that had access. Adding private
/// repositories therefore REQUIRES scoping this model (per-owner rows, or an explicit
/// access-grant table) before any private URL is accepted. Do not treat the sharing
/// here as a general property; it is a consequence of the public-only scope.
model Repository {
  id            String @id @default(cuid())
  /// GitHub owner and repo name, stored lowercase so lookups are case-insensitive.
  owner         String
  name          String
  defaultBranch String
  /// Head commit of the default branch when this snapshot was taken.
  commitSha     String

  /// Never inferred from row counts. A reader may only trust an index whose status is
  /// `ready`; anything else is partial, and answering from a partial index produces
  /// confident architectural claims about files that were never seen.
  status RepositoryStatus @default(pending)
  /// Set when status is `failed`, so the UI can say what went wrong.
  error  String?

  /// Extension counts, manifest, and detected entry points. Shape is owned by
  /// lib/repo/structure.ts rather than the schema, so it can grow without migrations.
  structure       Json?
  /// Dominant language by file count. The import graph, when it exists, covers this
  /// one language only.
  primaryLanguage String?
  fileCount       Int     @default(0)

  /// Whether exported symbols were actually extracted for this snapshot.
  ///
  /// LOAD-BEARING, and the reason it exists is worth stating: without it, a file with
  /// no symbols recorded is indistinguishable from a file whose symbols were never
  /// looked for. Selection would score against an empty set and silently behave as
  /// though it had checked and found nothing — absence of data passing as data showing
  /// absence, which is the same failure class as a truncated tree wearing a different
  /// costume.
  ///
  /// False for a snapshot indexed before symbol extraction existed, and for one whose
  /// archive could not be read. Both are usable, degraded, and KNOWN to be degraded.
  symbolsExtracted Boolean @default(false)

  /// Whether import edges were actually extracted for this snapshot.
  ///
  /// Exists for exactly the reason symbolsExtracted does, and the reason is the whole
  /// point: without it, a repository with no edges recorded is indistinguishable from
  /// one whose imports were never parsed. A consumer would read an empty graph as "this
  /// code has no internal dependencies" — a confident architectural claim derived from
  /// data that was never gathered.
  ///
  /// False for a snapshot indexed before edges existed, for one whose archive could not
  /// be read, and for a repository in a language whose imports are not parsed.
  importsExtracted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files     RepositoryFile[]
  fileEdges FileEdge[]
  projects  Project[]

  /// One row per snapshot. Re-ingesting the same commit finds the existing index
  /// instead of rebuilding it, which is what makes a retry after a failure cheap.
  @@unique([owner, name, commitSha])
  @@index([owner, name])
}

/// One entry from the repository's file tree. Contents are NOT stored — only what is
/// needed to decide whether a file is worth fetching.
///
/// `size` is the load-bearing column: it comes free from the tree API and lets the
/// selector estimate token cost and stay inside the context budget BEFORE spending a
/// GitHub API call per file. Without it, selection would have to fetch to find out.
model RepositoryFile {
  id           String     @id @default(cuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  /// POSIX path relative to the repo root, exactly as GitHub reports it.
  path         String
  /// Git blob SHA, so a file can be fetched by content address rather than by ref.
  blobSha      String
  /// Bytes, from the tree API.
  size         Int
  /// Derived from the extension. Null for files with no recognised extension.
  language     String?

  /// Exported symbol names — functions, classes, consts, types — for the primary
  /// language only. Empty when the file exports nothing, when it is not in the primary
  /// language, or when extraction never ran; Repository.symbolsExtracted is what
  /// separates the last case from the first two.
  ///
  /// An array column rather than a join table: selection already loads every candidate
  /// into memory to rank it, so a reverse index buys nothing today, while a 2,000-file
  /// repository would add roughly 10,000 rows against a 1 GB quota. Promote it to a
  /// table when exact symbol lookup ("go to definition") needs one.
  symbols String[] @default([])

  /// Names the file declares WITHOUT exporting — class members and top-level
  /// declarations. Weighted below `symbols` when scoring, because a public contract
  /// states a file's purpose more strongly than a private helper does, but indexed
  /// because a file can hold its entire meaning in names it never exports. Measured
  /// case: ky's Ky.ts exports one symbol and declares the whole retry loop.
  internalSymbols String[] @default([])

  /// Imports this file declares. Empty when it imports nothing, when its language is
  /// not parsed, or when extraction never ran — Repository.importsExtracted separates
  /// the last case from the first two.
  outgoingEdges FileEdge[] @relation("FileEdgeSource")
  /// Files that import THIS one. The reverse direction is why edges are a table rather
  /// than another array column: an array of targets answers "what does this need" but
  /// cannot answer "what breaks if I change this" without scanning every row.
  incomingEdges FileEdge[] @relation("FileEdgeTarget")

  @@unique([repositoryId, path])
  @@index([repositoryId, language])
}

/// How a specifier related to the repository it was found in.
enum FileEdgeKind {
  /// Named another file in this snapshot. `targetFileId` is set.
  resolved
  /// A bare specifier — a published package or a node builtin. Nothing here to name.
  external
  /// Looked like it named a file here (relative, or matched a tsconfig alias) and did
  /// not. Usually a file excluded from the index, or an alias resolved differently
  /// from the bundler. Kept because it is a signal, not noise.
  unresolved
}

/// A directed import edge: `sourceFile` imports `specifier`.
///
/// WHY UNRESOLVED EDGES ARE STORED
/// An edge list that dropped what it could not resolve would be indistinguishable from
/// one where those imports do not exist. The raw specifier is kept for every edge —
/// including the ones pointing outside this repository — so a reader can always tell
/// "this file imports nothing else here" from "this file's imports were not understood".
/// That is the same invariant Repository.symbolsExtracted protects, at row granularity.
///
/// NOT YET CONSUMED. Selection does not read this table. It is written and queryable so
/// that consuming it is a separate, reviewable change rather than a rewrite.
model FileEdge {
  id String @id @default(cuid())

  /// Denormalised from sourceFile so the common query — every edge in one repository —
  /// is a single index lookup rather than a join back through RepositoryFile.
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  sourceFileId String
  sourceFile   RepositoryFile @relation("FileEdgeSource", fields: [sourceFileId], references: [id], onDelete: Cascade)

  /// Null for `external` and `unresolved` kinds — there is no row to point at.
  targetFileId String?
  targetFile   RepositoryFile? @relation("FileEdgeTarget", fields: [targetFileId], references: [id], onDelete: Cascade)

  /// The specifier exactly as written in the source, before any resolution.
  specifier String
  kind      FileEdgeKind

  createdAt DateTime @default(now())

  /// Idempotency, enforced by the database rather than by the writer remembering to.
  /// One file importing one specifier is one edge however many times the line appears
  /// and however many times the repository is re-ingested.
  @@unique([sourceFileId, specifier])
  @@index([repositoryId, sourceFileId])
  @@index([repositoryId, targetFileId])
}
