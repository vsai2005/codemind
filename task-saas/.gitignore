# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# backfill backups (contain original message content)
/backups
dev.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Added by `vercel link`. The CLI also appended a blanket `.env*`, which was
# removed: it shadows .env.example, a file this repo deliberately tracks. The
# real env files are already covered by `.env*.local` and `.env` above.
.vercel

# Measurement script output (scripts/measure-artifacts.ts). Local evidence, never committed.
.measure/

# Claude Code local dev config. launch.json names the dev-server command and port
# for THIS machine, and settings.local.json is local by convention. The rest of
# .claude/ is deliberately NOT ignored -- settings.json, skills, agents, and
# commands are shareable, and a blanket rule would silently block them later.
.claude/launch.json
.claude/settings.local.json
