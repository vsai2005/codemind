# =============================================================================
# CodeMind — example configuration. Copy to .env and fill in.
# Never commit a real .env. Never put real credentials in this file.
# =============================================================================

# --- Required -----------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tasksaas?schema=public"

# Auth.js session secret. Generate with: npx auth secret
# Must be at least 32 characters.
AUTH_SECRET="generate-with-npx-auth-secret-min-32-chars"

# Required when the app is served on any host other than localhost
# (Docker, LAN/mobile access, reverse proxy).
AUTH_TRUST_HOST=true

# --- Demo authentication ------------------------------------------------------
# CodeMind's built-in sign-in opens a shared, seeded demo workspace with no
# password. It is a local convenience, NOT an authentication system.
#
#   true  -> the one-click demo sign-in is available
#   unset -> no sign-in provider is registered and sign-in fails closed
#
# Leave this OFF for anything reachable beyond your own machine or trusted LAN.
CODEMIND_DEMO_AUTH=true

# --- NVIDIA NIM ---------------------------------------------------------------
# At least one key is required for chat and artifact generation. Extra slots are
# used for automatic failover when a key is rate limited.
# Keys are read server-side only and are never sent to the browser.
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
NVIDIA_API_KEY_5=

# --- Optional: NVIDIA model selection (sensible defaults are built in) ---------
# NEMOTRON_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
# NEMOTRON_BASE_URL="https://integrate.api.nvidia.com/v1"
# NVIDIA_VISION_MODEL="meta/llama-3.2-90b-vision-instruct"

# --- Optional: NVIDIA key scheduling -------------------------------------------
# NVIDIA_MAX_CONCURRENT_PER_KEY=4   # in-flight requests allowed per key
# NVIDIA_MAX_RETRIES=3              # failover attempts across keys (hard capped at 5)
# NVIDIA_KEY_COOLDOWN_MS=60000      # base cooldown after a key failure

# --- Additional model providers ------------------------------------------------
# CodeMind is multi-model. A provider whose key is absent simply shows as
# "Unavailable" in the model selector — the app runs normally with only NVIDIA set.
# All keys are server-side only and never reach the browser or the database.

# Google Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=
# GEMINI_MODEL="gemini-3.1-pro-preview"   # Pro tier; falls back to a Flash id if quota is Flash-only
# GEMINI_DISPLAY_NAME="Gemini 3.1 Pro"    # label shown in the model selector
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"

# DeepSeek (served over NVIDIA's OpenAI-compatible integrate API, own credential)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL="deepseek-ai/deepseek-v4-flash-0731"
# DEEPSEEK_DISPLAY_NAME="DeepSeek V4 Flash"
# DEEPSEEK_BASE_URL="https://integrate.api.nvidia.com/v1"

# --- Context and generation budgets -------------------------------------------
# Total context window. The benchmarked hard ceiling for
# nvidia/nemotron-3-ultra-550b-a55b on integrate.api.nvidia.com is 1,048,576 tokens.
# 512K leaves margin because ContextManager estimates at 4 chars/token, which
# under-counts dense code. Must be kept in step with MAX_MESSAGE_CHARS in
# types/chat.ts — see README "Context limits".
AI_CONTEXT_MAX_TOKENS=512000

# AI_MAX_OUTPUT_TOKENS=8192            # per normal chat reply
# AI_ARTIFACT_MAX_OUTPUT_TOKENS=16000  # per artifact generation (hard capped at 32000)

# --- Optional: local development ----------------------------------------------
# Disables rate limiting entirely. Local development / load testing only.
# CODEMIND_DISABLE_RATE_LIMIT=true
