# =============================================================================
# CodeMind configuration — copy to .env and fill in.
#
# PLACEHOLDERS ONLY. Never commit a real value to this file or to the repository.
# .env and .env*.local are gitignored; keep every real secret in those.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REQUIRED IN PRODUCTION
# -----------------------------------------------------------------------------

# PostgreSQL connection string. In production this points at your managed
# instance (e.g. Aiven) and is supplied by the platform, never hardcoded.
# Aiven requires TLS — keep the ?sslmode=require that its console gives you.
#   local  : postgresql://postgres:postgres@localhost:5432/tasksaas?schema=public
#   Aiven  : postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL="YOUR_POSTGRES_CONNECTION_STRING"

# Auth.js session secret. Generate with: npx auth secret
# Must be at least 32 characters. Rotating it invalidates all active sessions.
AUTH_SECRET="replace-me-with-a-32-character-minimum-secret"

# Required whenever the app is served on any host other than localhost
# (Docker, LAN, a reverse proxy, or any hosting platform).
AUTH_TRUST_HOST="true"

# Canonical public URL. Set this in production so auth callbacks and secure
# cookies resolve correctly behind a proxy.
# AUTH_URL="https://your-deployment-hostname"


# -----------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS — AI providers and GitHub (never reach the browser)
# -----------------------------------------------------------------------------

# NVIDIA NIM. At least one key is required for chat and artifact generation.
# Extra slots enable automatic load-aware failover; empty slots are ignored.
NVIDIA_API_KEY_1=""
NVIDIA_API_KEY_2=""
NVIDIA_API_KEY_3=""
NVIDIA_API_KEY_4=""
NVIDIA_API_KEY_5=""

# Google Gemini (OpenAI-compatible endpoint). Optional.
GEMINI_API_KEY=""

# DeepSeek, served over NVIDIA's integrate API on its own credential. Optional.
DEEPSEEK_API_KEY=""

# A provider with no key simply shows as "Unavailable" in the model selector;
# the application runs normally with only NVIDIA configured.

# GitHub, for attaching a public repository to a project. Required for that
# feature and nothing else — the rest of the app runs fine without it.
#
# Unlike a missing provider key, this one fails LOUDLY and late: the repo field
# still appears in the New Project dialog, and every attach returns
# "Repository indexing is not configured on this server." Indexing refuses to
# start unauthenticated on purpose — GitHub allows 60 requests/hour with no
# token, which cannot index a real repository, and failing up front is clearer
# than dying partway through with a rate-limit error.
#
# A classic PAT with NO scopes is enough (public repositories only). The token is
# read from this environment and is NEVER accepted from a client, so it cannot be
# used to borrow the server's identity.
GITHUB_TOKEN=""


# -----------------------------------------------------------------------------
# 3. DEMO-ONLY (must stay false in production)
# -----------------------------------------------------------------------------

# Passwordless sign-in to a shared seeded workspace. Local development only.
# When false or absent, real email/password accounts are required and there is
# no silent fallback. NEVER enable this on a network-reachable deployment.
CODEMIND_DEMO_AUTH="false"


# -----------------------------------------------------------------------------
# 4. OPTIONAL — model selection (sensible defaults are built in)
# -----------------------------------------------------------------------------

# NEMOTRON_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
# NEMOTRON_BASE_URL="https://integrate.api.nvidia.com/v1"
# NVIDIA_VISION_MODEL="meta/llama-3.2-90b-vision-instruct"

# GEMINI_MODEL="gemini-3.1-pro-preview"   # a Flash-only key must use a Flash id
# GEMINI_DISPLAY_NAME="Gemini 3.1 Pro"    # label shown in the model selector
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"

# KIMI_MODEL="moonshotai/kimi-k3"       # served over NVIDIA's integrate API on the
#                                       # NVIDIA_API_KEY_* pool — no separate credential
# KIMI_DISPLAY_NAME="Kimi K3"

# DEEPSEEK_MODEL="deepseek-ai/deepseek-v4-flash-0731"
# DEEPSEEK_DISPLAY_NAME="DeepSeek V4 Flash"
# DEEPSEEK_BASE_URL="https://integrate.api.nvidia.com/v1"

# Models used for background work. Default to the user's selection / house default.
# CODEMIND_PLANNER_MODEL="nemotron-3-ultra"
# CODEMIND_SUMMARY_MODEL="nemotron-3-ultra"
# GLM 5.3 Flash is served through the same OPENROUTER_API_KEY as the other OpenRouter
# entries. This variable only repoints WHICH model that key is asked for; the catalogue
# also carries z-ai/glm-5.3 (a different, pricier model), z-ai/glm-5.3-flash:batch and
# the floating alias ~z-ai/glm-flash-latest, and they are not interchangeable.
# OPENROUTER_GLM_MODEL="z-ai/glm-5.3-flash"

# How much OpenRouter models may think before answering.
#
# Measured on z-ai/glm-5.3-flash on 2026-09-03: with no reasoning field it spends the
# ENTIRE completion budget on the reasoning pass and returns an empty string -- 1,999 of
# 2,000 tokens at max_tokens 2000, and 8,000 of 8,000 at max_tokens 8000, so a larger
# budget is simply eaten too. Disabling is refused: OpenRouter replies 400 "Reasoning is
# mandatory for this endpoint and cannot be disabled".
#
# A HARD TOKEN CAP IS THE DEFAULT (512). Both {"max_tokens":512} and {"effort":"low"}
# drove reasoning_tokens to zero, so the two were compared on the real path:
#
#   single-debounce  effort=low       15,294ms PASS | 180,039ms hit the 180s deadline
#   single-debounce  max_tokens=512   10,515ms PASS |  23,075ms PASS
#   zip-large-ecom   effort=low      103,839 / 120,320 / 129,617ms
#   zip-large-ecom   max_tokens=512  121,331 / 106,661ms
#
# The large case is a wash; the small case is not. Two to three runs per cell is a thin
# sample, so the tie-breaker is a property rather than a p-value: a cap is a number the
# provider must honour, "low" is a hint each model reads differently.
#
# Values under 64 are treated as typos and ignored.
# OPENROUTER_REASONING_MAX_TOKENS=512

# Overrides the lever entirely: low | medium | high to send an effort instead of a cap,
# or off to send no reasoning field at all and reproduce the empty-output failure above.
# OPENROUTER_REASONING_EFFORT=low

# CODEMIND_INTENT_MODEL="ising-calibration-1-5"
# CODEMIND_ENHANCER_MODEL="ministral-3b"

# The provider-side id behind the ministral-3b registry entry, used by the composer's
# Enhance action. Chosen on WORST-CASE latency over four samples each, because it sits
# under a spinner the user is watching:
#   ministral-3b   p50  572ms  max  585ms   <- chosen
#   qwen-2.5-7b    p50  679ms  max  797ms
#   gpt-4.1-nano   p50 1010ms  max 1032ms
#   llama-3.2-3b   p50 1134ms  max 1419ms
#   llama-3.1-8b   p50 3144ms  max 3227ms
# OPENROUTER_ENHANCER... no: this one has its own variable so it cannot repoint the
# other OpenRouter entries.
# CODEMIND_ENHANCER_PROVIDER_MODEL="mistralai/ministral-3b-2512"


# Model-backed intent escalation.
#
# Artifact requests are routed by rules in lib/ai/intent.ts. Those rules are precise
# about the obvious phrasings and miss unusual ones, so a message they DECLINE while
# still mentioning something deliverable gets a one-word classification call before the
# reply starts. Measured at 17.4% of a validation set, and 0% of messages that mention
# nothing deliverable.
#
# It can only ADD an intent the rules left unset, never override one they made, and it
# fails closed: a timeout, an outage or an unexpected answer all leave the turn as
# ordinary chat, which is what would have happened without it.
#
# ON BY DEFAULT. Set to exactly "false" to run rules-only; any other value leaves it on.
#
# It shipped disabled, because at the time every registry model was a frontier reasoning
# model: a one-word prompt came back empty or mid-thought, and the fastest took five
# seconds. That changed when ising-calibration-1-5 was added as an internal entry -- a
# small non-reasoning model, chosen after probing all 81 models NVIDIA advertises and
# finding twelve actually servable.
#
# Re-measured through the real code path, 8 repeats over 5 cases:
#   p50 240ms   p90 320ms   p99 3198ms   1 of 40 calls over one second
#
# So the cost is roughly 240ms on the ~16% of turns that mention something deliverable
# and match no rule. Nothing is added to the other 84%, and nothing to any message the
# rules already classified.
# CODEMIND_INTENT_ESCALATION=false

# The provider-side id behind the ising-calibration-1-5 registry entry. Not a well-known
# public model, and the last OpenRouter entry in the registry was deleted when its id
# 404'd upstream, so this is overridable without a deploy. The measured alternative is
# meta/llama-3.2-11b-vision-instruct -- slower (1174ms avg, 5258ms max) and it produced a
# false positive the chosen model did not.
# CODEMIND_INTENT_PROVIDER_MODEL="nvidia/ising-calibration-1.5-31b"


# -----------------------------------------------------------------------------
# 5. OPTIONAL — context and generation budgets
# -----------------------------------------------------------------------------

# These are the SHIPPED DEFAULTS, defined in lib/env.ts and applied when the variable
# is unset or empty. They are listed here so you can see what you are running with;
# uncomment only to override. Values outside the supported range are clamped and the
# adjustment is reported at startup.
#
# AI_CONTEXT_MAX_TOKENS=512000          # total context window   (256 – 1048576)
# AI_MAX_OUTPUT_TOKENS=16384            # global output ceiling  (64 – 131072)
# AI_ARTIFACT_MAX_OUTPUT_TOKENS=16000   # per artifact           (256 – 32000)
#
# Deadline for the intent classification call above. Short on purpose: it sits in front
# of the user's reply and asks for a single word, so a model that has not answered in
# three seconds is one this request should stop waiting for. Raising it buys silence,
# not accuracy — turn escalation off instead.
# CODEMIND_INTENT_TIMEOUT_MS=3000       # intent second look     (500 - 15000)

# -----------------------------------------------------------------------------
# 5b. OPTIONAL — HTTP request size limits (scale these with the instance)
# -----------------------------------------------------------------------------

# How many bytes and characters the process will hold for ONE chat request. These are
# transport limits, NOT the AI context window — a full 512,000-token turn is about
# 2,000,000 characters and fits inside both defaults.
#
# The defaults are sized for a 512MB instance (Render's free plan). Raise them on a
# larger machine; no code change or rebuild is needed. Out-of-range values are clamped
# and reported at startup, and startup warns if the byte limit is not above the
# character limit.
#
# Reference:  ~2,000,000 chars = a maximum-size message (the full context window)
#            ~14,000,000 chars = one 10MB image attachment, base64-encoded
#
# CODEMIND_CHAT_BODY_MAX_BYTES=20971520    # 20MB   (1MB – 512MB)
# CODEMIND_REQUEST_MAX_CHARS=16000000      # 16M    (100000 – 400000000)


# -----------------------------------------------------------------------------
# 6. OPTIONAL — provider reliability tuning
# -----------------------------------------------------------------------------

# NVIDIA_MAX_CONCURRENT_PER_KEY=4       # in-flight requests per key
# NVIDIA_MAX_RETRIES=3                  # failover attempts (hard capped at 5)
# NVIDIA_KEY_COOLDOWN_MS=60000          # base cooldown after a key failure

# OpenRouter, which brokers models from many vendors behind one credential.
# Serves the Inkling Small entry. Optional. Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL="thinkingmachines/inkling-small:free"   # the ":free" suffix is a
#                                       # DISTINCT id from the paid one; the catalogue
#                                       # also carries ":batch" and a full-size "inkling"
# OPENROUTER_DISPLAY_NAME="Inkling Small"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# OPENROUTER_SITE_URL="https://your-deployment.example.com"  # sent as HTTP-Referer for
#                                       # OpenRouter's usage attribution; purely cosmetic

# AI_PROVIDER_HEADER_TIMEOUT_MS=60000   # STREAMED calls: give up if no response headers arrive
# AI_PROVIDER_COMPLETION_TIMEOUT_MS=180000  # NON-STREAMED calls (artifacts): whole-generation
#                                       # deadline. A non-streamed provider sends no headers
#                                       # until the completion is finished, so the wait covers
#                                       # generation, not just the header phase.


# -----------------------------------------------------------------------------
# 7. OPTIONAL — local development only
# -----------------------------------------------------------------------------

# Disables rate limiting entirely. Never set this in production.
# CODEMIND_DISABLE_RATE_LIMIT="true"


# -----------------------------------------------------------------------------
# 8. DEPLOYMENT — reverse proxy and local database
# -----------------------------------------------------------------------------

# How many reverse proxies YOU operate in front of this app.
#
# x-forwarded-for is written by the client, so only the entries appended by your own
# proxies mean anything. This says how many to trust, counted from the right.
#   0  no trusted proxy (default) — the header is ignored, and unauthenticated
#      requests share one rate-limit bucket
#   1  one reverse proxy: nginx, Caddy, a single load balancer
#   2  a CDN in front of a load balancer
#
# Set this whenever the app is reachable through a proxy, or per-IP rate limiting
# cannot work.
# CODEMIND_TRUSTED_PROXY_HOPS=1

# Credentials for the PostgreSQL container in docker-compose.yml. POSTGRES_PASSWORD has
# no default — compose refuses to start without it rather than running the database
# with a guessable password. Ignored when you point DATABASE_URL at a managed instance.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=tasksaas
