# =============================================================================
# CodeMind configuration — copy to .env and fill in.
#
# PLACEHOLDERS ONLY. Never commit a real value to this file or to the repository.
# .env and .env*.local are gitignored; keep every real secret in those.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REQUIRED IN PRODUCTION
# -----------------------------------------------------------------------------

# PostgreSQL connection string. In production this points at your managed
# instance (e.g. Aiven) and is supplied by the platform, never hardcoded.
# Aiven requires TLS — keep the ?sslmode=require that its console gives you.
#   local  : postgresql://postgres:postgres@localhost:5432/tasksaas?schema=public
#   Aiven  : postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL="YOUR_POSTGRES_CONNECTION_STRING"

# Auth.js session secret. Generate with: npx auth secret
# Must be at least 32 characters. Rotating it invalidates all active sessions.
AUTH_SECRET="replace-me-with-a-32-character-minimum-secret"

# Required whenever the app is served on any host other than localhost
# (Docker, LAN, a reverse proxy, or any hosting platform).
AUTH_TRUST_HOST="true"

# Canonical public URL. Set this in production so auth callbacks and secure
# cookies resolve correctly behind a proxy.
# AUTH_URL="https://your-deployment-hostname"


# -----------------------------------------------------------------------------
# 2. AI PROVIDER SECRETS (server-side only — never reach the browser)
# -----------------------------------------------------------------------------

# NVIDIA NIM. At least one key is required for chat and artifact generation.
# Extra slots enable automatic load-aware failover; empty slots are ignored.
NVIDIA_API_KEY_1=""
NVIDIA_API_KEY_2=""
NVIDIA_API_KEY_3=""
NVIDIA_API_KEY_4=""
NVIDIA_API_KEY_5=""

# Google Gemini (OpenAI-compatible endpoint). Optional.
GEMINI_API_KEY=""

# DeepSeek, served over NVIDIA's integrate API on its own credential. Optional.
DEEPSEEK_API_KEY=""

# A provider with no key simply shows as "Unavailable" in the model selector;
# the application runs normally with only NVIDIA configured.


# -----------------------------------------------------------------------------
# 3. DEMO-ONLY (must stay false in production)
# -----------------------------------------------------------------------------

# Passwordless sign-in to a shared seeded workspace. Local development only.
# When false or absent, real email/password accounts are required and there is
# no silent fallback. NEVER enable this on a network-reachable deployment.
CODEMIND_DEMO_AUTH="false"


# -----------------------------------------------------------------------------
# 4. OPTIONAL — model selection (sensible defaults are built in)
# -----------------------------------------------------------------------------

# NEMOTRON_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
# NEMOTRON_BASE_URL="https://integrate.api.nvidia.com/v1"
# NVIDIA_VISION_MODEL="meta/llama-3.2-90b-vision-instruct"

# GEMINI_MODEL="gemini-3.1-pro-preview"   # a Flash-only key must use a Flash id
# GEMINI_DISPLAY_NAME="Gemini 3.1 Pro"    # label shown in the model selector
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"

# DEEPSEEK_MODEL="deepseek-ai/deepseek-v4-flash-0731"
# DEEPSEEK_DISPLAY_NAME="DeepSeek V4 Flash"
# DEEPSEEK_BASE_URL="https://integrate.api.nvidia.com/v1"

# Models used for background work. Default to the user's selection / house default.
# CODEMIND_PLANNER_MODEL="nemotron-3-ultra"
# CODEMIND_SUMMARY_MODEL="nemotron-3-ultra"


# -----------------------------------------------------------------------------
# 5. OPTIONAL — context and generation budgets
# -----------------------------------------------------------------------------

# These are the SHIPPED DEFAULTS, defined in lib/env.ts and applied when the variable
# is unset or empty. They are listed here so you can see what you are running with;
# uncomment only to override. Values outside the supported range are clamped and the
# adjustment is reported at startup.
#
# AI_CONTEXT_MAX_TOKENS=512000          # total context window   (8000 – 1048576)
# AI_MAX_OUTPUT_TOKENS=16384            # global output ceiling  (256 – 131072)
# AI_ARTIFACT_MAX_OUTPUT_TOKENS=16000   # per artifact           (1000 – 32000)


# -----------------------------------------------------------------------------
# 6. OPTIONAL — provider reliability tuning
# -----------------------------------------------------------------------------

# NVIDIA_MAX_CONCURRENT_PER_KEY=4       # in-flight requests per key
# NVIDIA_MAX_RETRIES=3                  # failover attempts (hard capped at 5)
# NVIDIA_KEY_COOLDOWN_MS=60000          # base cooldown after a key failure
# AI_PROVIDER_HEADER_TIMEOUT_MS=60000   # give up if no response headers arrive


# -----------------------------------------------------------------------------
# 7. OPTIONAL — local development only
# -----------------------------------------------------------------------------

# Disables rate limiting entirely. Never set this in production.
# CODEMIND_DISABLE_RATE_LIMIT="true"


# -----------------------------------------------------------------------------
# 8. DEPLOYMENT — reverse proxy and local database
# -----------------------------------------------------------------------------

# How many reverse proxies YOU operate in front of this app.
#
# x-forwarded-for is written by the client, so only the entries appended by your own
# proxies mean anything. This says how many to trust, counted from the right.
#   0  no trusted proxy (default) — the header is ignored, and unauthenticated
#      requests share one rate-limit bucket
#   1  one reverse proxy: nginx, Caddy, a single load balancer
#   2  a CDN in front of a load balancer
#
# Set this whenever the app is reachable through a proxy, or per-IP rate limiting
# cannot work.
# CODEMIND_TRUSTED_PROXY_HOPS=1

# Credentials for the PostgreSQL container in docker-compose.yml. POSTGRES_PASSWORD has
# no default — compose refuses to start without it rather than running the database
# with a guessable password. Ignored when you point DATABASE_URL at a managed instance.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=tasksaas
